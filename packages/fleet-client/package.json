{
  "name": "@broberg/fleet-client",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed client for the broberg fleet HTTP API (buddy + cardmem). One import instead of hand-rolling fetch + Bearer + payload — typed end-to-end from @broberg/fleet-contracts.",
  "license": "FSL-1.1-Apache-2.0",
  "author": "Christian Broberg <cb@webhouse.dk>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/fleet.git",
    "directory": "packages/fleet-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@broberg/fleet-contracts": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "bun-types": "^1.3.0",
    "@types/node": "^22.0.0"
  }
}
